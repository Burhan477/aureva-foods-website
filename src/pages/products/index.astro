---
import EnquiryCTA from "../../components/sections/EnquiryCTA.astro";
import Categories from "../../components/sections/products/Categories.astro";
import Portfolio from "../../components/sections/products/Portfolio.astro";
import { productCategories } from "../../data/navigation";
import { enquiryCta } from "../../data/products-overview";
import BaseLayout from "../../layouts/BaseLayout.astro";

// Products Overview (SITE_STRUCTURE.md §4.3), in the section order of the
// owner's brief (2026-10-26). Title and description are the
// SEO_AND_PERFORMANCE.md §3.2 drafts (SUGGESTION), approved page by page
// in M6.3.
---

<BaseLayout
  title="Products | Aureva Foods"
  description="Explore Aureva Foods' three product ranges: spices, dehydrated products, and fresh fruits and vegetables from India. Request a quote for bulk supply."
  collection={productCategories.map(({ label, href }) => ({
    name: label,
    url: href,
  }))}
  ogImage={{
    path: "/og/products.jpg",
    alt: "Fresh ginger, cinnamon sticks, a pomegranate, sliced fruit, garlic and herbs on a table, beside the Aureva logo",
  }}
>
  <main id="main">
    <Categories />
    <Portfolio />
    <EnquiryCTA content={enquiryCta} />
  </main>
</BaseLayout>
