---
import { Image } from "astro:assets";
import { Menu, X } from "lucide-react";

import monogram from "../../assets/images/brand/aureva-foods-monogram.png";
import {
  aboutLink,
  contactLink,
  homeLink,
  isCurrentPath,
  isExactPath,
} from "../../data/navigation";
import WhatsAppButton from "../ui/WhatsAppButton.astro";
import MobileMenu from "./MobileMenu.astro";
import ProductsMenu from "./ProductsMenu.astro";
import {
  desktopNavItem,
  desktopNavLabel,
  desktopNavUnderline,
} from "./navClasses";

/**
 * Sticky site header (COMPONENT_INVENTORY.md, Header): logo, main
 * navigation with the Products mega menu, WhatsApp Us (from lg). Noir,
 * like the Footer (owner, 2026-10-27), so it uses the Footer's monogram
 * and light wordmark (the full logo's dark lettering does not read on
 * noir), light links with Emerald 500 for hover and the current page, and
 * the dark WhatsApp Us (DESIGN_SYSTEM.md §9.1). Below lg the navigation
 * moves into MobileMenu and WhatsApp Us leaves the bar for
 * FloatingWhatsApp (owner, 2026-10-27).
 */
const pathname = Astro.url.pathname;

const links = {
  home: isExactPath(pathname, homeLink.href),
  about: isCurrentPath(pathname, aboutLink.href),
  contact: isCurrentPath(pathname, contactLink.href),
};
---

<header class="group/header sticky top-0 z-(--z-header)" data-site-header>
  <!-- Background and scroll shadow sit on their own layers so the header
       itself never becomes a containing block for the fixed mobile menu -->
  <div
    class="absolute inset-0 border-b border-white/10 bg-inverse"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute inset-0 opacity-0 shadow-float transition-opacity duration-(--duration-base) ease-out group-data-scrolled/header:opacity-100"
    aria-hidden="true"
  ></div>
  <!-- Reading progress (§16): covers the bottom border, so it never moves
       the layout; navigation.ts scales it with the page scroll -->
  <div
    class="pointer-events-none absolute inset-x-0 -bottom-px h-0.75 origin-left scale-x-0 bg-accent"
    aria-hidden="true"
    data-scroll-progress
  ></div>

  <div class="relative container-wide flex h-(--header-height) items-center justify-between gap-3 text-text-inverse [--color-focus:var(--color-accent)] lg:grid lg:grid-cols-[1fr_auto_1fr] lg:gap-6">
    <a
      href={homeLink.href}
      class="flex shrink-0 items-center gap-3 rounded-md"
      aria-label="Aureva Foods home"
    >
      <Image
        src={monogram}
        alt=""
        width={48}
        densities={[1, 2]}
        loading="eager"
        class="size-10 rounded-lg lg:size-12"
      />
      <span class="font-display text-h4 font-semibold tracking-wide whitespace-nowrap max-sm:sr-only">
        AUREVA FOODS
      </span>
    </a>

    <nav aria-label="Main" class="hidden self-stretch lg:flex">
      <ul class="flex items-stretch">
        <li class="flex">
          <a
            href={homeLink.href}
            class={desktopNavItem}
            aria-current={links.home ? "page" : undefined}
          >
            <span class={desktopNavLabel}>
              {homeLink.label}
              <span class={desktopNavUnderline} aria-hidden="true"></span>
            </span>
          </a>
        </li>
        <li class="flex">
          <a
            href={aboutLink.href}
            class={desktopNavItem}
            aria-current={links.about ? "page" : undefined}
          >
            <span class={desktopNavLabel}>
              {aboutLink.label}
              <span class={desktopNavUnderline} aria-hidden="true"></span>
            </span>
          </a>
        </li>
        <ProductsMenu pathname={pathname} />
        <li class="flex">
          <a
            href={contactLink.href}
            class={desktopNavItem}
            aria-current={links.contact ? "page" : undefined}
          >
            <span class={desktopNavLabel}>
              {contactLink.label}
              <span class={desktopNavUnderline} aria-hidden="true"></span>
            </span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="flex items-center gap-2 lg:justify-self-end">
      <!-- Below lg, WhatsApp Us floats bottom-left (FloatingWhatsApp) and
           sits in MobileMenu -->
      <WhatsAppButton tone="dark" class="max-lg:hidden" />

      <!-- Without JavaScript, "Menu" jumps to the footer links -->
      <a
        href="#footer-navigation"
        class="inline-flex size-11 items-center justify-center rounded-md text-mist lg:hidden"
        aria-label="Menu"
        data-mobile-menu-fallback
      >
        <Menu className="size-6" strokeWidth={1.75} aria-hidden="true" />
      </a>
      <button
        type="button"
        class="group inline-flex size-11 items-center justify-center rounded-md text-mist transition-colors duration-(--duration-fast) hover:bg-white/10 lg:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mobile-menu-toggle
        hidden
      >
        <Menu
          className="size-6 group-aria-expanded:hidden"
          strokeWidth={1.75}
          aria-hidden="true"
        />
        <X
          className="hidden size-6 group-aria-expanded:block"
          strokeWidth={1.75}
          aria-hidden="true"
        />
      </button>
    </div>
  </div>

  <MobileMenu pathname={pathname} />
</header>

<script>
  import "../../scripts/navigation";
</script>
