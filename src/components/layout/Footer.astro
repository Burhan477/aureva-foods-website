---
import { Image } from "astro:assets";

import monogram from "../../assets/images/brand/aureva-foods-monogram.png";
import {
  homeLink,
  legalNav,
  mainNav,
  productCategories,
} from "../../data/navigation";
import { confirmed, site } from "../../data/site";
import PendingContent from "../ui/PendingContent.astro";
import WhatsAppButton from "../ui/WhatsAppButton.astro";

/**
 * Global footer (SITE_STRUCTURE.md §3.2), an inverse (olive) band.
 * Contact, partner and social details render only when CONFIRMED in
 * src/data/site.ts; until then a PendingContent marker shows in
 * development and nothing in production.
 *
 * The full logo is about 1.2:1 against olive (ASSET_GUIDELINES.md §10),
 * so the footer uses the monogram with an Ivory text wordmark, as
 * recommended there under C-13.
 */
// Build year; updates on each rebuild. Trading name until C-29 is resolved.
const copyright = `© ${new Date().getFullYear()} ${site.name.value}. All rights reserved.`;

const email = confirmed(site.email);
const phone = confirmed(site.phone);
const socialLinks = confirmed(site.social) ?? [];

const linkClass =
  "inline-flex min-h-11 items-center text-text-inverse underline-offset-4 hover:underline aria-[current=page]:underline";
---

<footer
  id="site-footer"
  class="bg-inverse text-text-inverse [--color-focus:var(--color-accent)]"
>
  <div class="container-wide pt-section-tight pb-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <div class="sm:col-span-2 lg:col-span-4">
        <a
          href={homeLink.href}
          class="inline-flex items-center gap-3 rounded-md"
          aria-label="Aureva Foods home"
        >
          <Image
            src={monogram}
            alt=""
            width={56}
            densities={[1, 2]}
            loading="lazy"
            decoding="async"
            class="size-14 rounded-lg"
          />
          <span class="font-display text-h3 tracking-wide">AUREVA FOODS</span>
        </a>
        {site.footerIntro.value && (
          <p class="mt-5 max-w-sm">
            {/* TEMPORARY: draft copy awaiting approval (site.ts) */}
            {site.footerIntro.value}
          </p>
        )}
      </div>

      <nav
        id="footer-navigation"
        aria-labelledby="footer-pages-title"
        class="lg:col-span-2"
      >
        <h2 id="footer-pages-title" class="text-h4 font-semibold">
          Pages
        </h2>
        <ul class="mt-3">
          {mainNav.map((link) => (
            <li>
              <a href={link.href} class={linkClass}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-labelledby="footer-products-title" class="lg:col-span-3">
        <h2 id="footer-products-title" class="text-h4 font-semibold">
          Products
        </h2>
        <ul class="mt-3">
          {productCategories.map((category) => (
            <li>
              <a href={category.href} class={linkClass}>
                {category.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="sm:col-span-2 lg:col-span-3">
        <h2 class="text-h4 font-semibold">Business Enquiries</h2>
        <p class="mt-3 max-w-sm">
          Message our team on WhatsApp to discuss your requirements.
        </p>
        <WhatsAppButton tone="dark" class="mt-5" />

        {(email || phone) && (
          <ul class="mt-5">
            {email && (
              <li>
                <a href={`mailto:${email}`} class={linkClass}>
                  {email}
                </a>
              </li>
            )}
            {phone && (
              <li>
                <a href={`tel:${phone.replace(/\s/g, "")}`} class={linkClass}>
                  {phone}
                </a>
              </li>
            )}
          </ul>
        )}

        {socialLinks.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-x-6">
            {socialLinks.map((social) => (
              <li>
                <a
                  href={social.href}
                  class={linkClass}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {social.label}
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        )}

        <PendingContent
          item="C-03, C-04, C-20, C-29"
          note="Email, partner company and social links appear here once confirmed. Copyright uses the trading name until the legal name is supplied."
          class="mt-5"
        />
      </div>
    </div>

    <div class="mt-12 flex flex-col-reverse gap-2 border-t border-mist/20 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-legal">{copyright}</p>
      {legalNav.length > 0 && (
        <ul class="flex flex-wrap gap-x-6 text-small">
          {legalNav.map((link) => (
            <li>
              <a href={link.href} class={linkClass}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</footer>
