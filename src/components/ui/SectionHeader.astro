---
/**
 * Section heading block (DESIGN_SYSTEM.md §6.2, D-24): optional short
 * label, h2 and one-sentence intro, stacked and centred on one axis
 * (owner instruction, 2026-10-27). An optional `action` slot (such as a
 * "View all" link) sits centred below the text. Reveals once (§14).
 *
 * `level={1}` makes the heading the page h1 (for a page that opens with
 * this section); it then uses the h1 size and is never hidden by a reveal,
 * because it is visible on first load (§14).
 */
interface Props {
  /** id of the heading, referenced by the section's aria-labelledby */
  id: string;
  level?: 1 | 2;
  eyebrow?: string;
  title: string;
  intro?: string;
  class?: string;
}

const { id, level = 2, eyebrow, title, intro, class: className } = Astro.props;
const Heading = `h${level}` as const;
const hasAction = Astro.slots.has("action");
---

<div
  class:list={["flex flex-col items-center gap-6 text-center", className]}
  data-reveal={level === 2 || undefined}
>
  <div class="max-w-3xl">
    {eyebrow && (
      <p class="text-eyebrow font-semibold text-primary">{eyebrow}</p>
    )}
    <Heading
      id={id}
      class:list={[
        "font-display text-balance text-heading",
        level === 1 ? "text-h1" : "text-h2",
        eyebrow && "mt-4",
      ]}
    >
      {title}
    </Heading>
    {intro && (
      <p class="mx-auto mt-4 max-w-[60ch] text-lead text-pretty text-text-muted">
        {intro}
      </p>
    )}
  </div>

  {hasAction && (
    <div class="shrink-0">
      <slot name="action" />
    </div>
  )}
</div>
