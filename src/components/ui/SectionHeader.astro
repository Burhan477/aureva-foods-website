---
/**
 * Section heading block (DESIGN_SYSTEM.md §6.2, D-24): optional short
 * label, h2 and one-sentence intro, stacked and left-aligned. An optional
 * `action` slot (such as a "View all" link) sits at the right edge from
 * lg and below the text on smaller screens. Reveals once (§14).
 */
interface Props {
  /** id of the h2, referenced by the section's aria-labelledby */
  id: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  class?: string;
}

const { id, eyebrow, title, intro, class: className } = Astro.props;
const hasAction = Astro.slots.has("action");
---

<div
  class:list={[
    "flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-16",
    className,
  ]}
  data-reveal
>
  <div class="max-w-3xl">
    {eyebrow && (
      <p class="text-eyebrow font-semibold text-primary">{eyebrow}</p>
    )}
    <h2
      id={id}
      class:list={[
        "font-display text-h2 text-balance text-heading",
        eyebrow && "mt-4",
      ]}
    >
      {title}
    </h2>
    {intro && (
      <p class="mt-4 max-w-[60ch] text-lead text-text-muted">{intro}</p>
    )}
  </div>

  {hasAction && (
    <div class="shrink-0">
      <slot name="action" />
    </div>
  )}
</div>
