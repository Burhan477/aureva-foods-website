---
import type { NavLink } from "../../data/navigation";

/**
 * Breadcrumbs (COMPONENT_INVENTORY.md §4, C-32): category pages only.
 * Set in the eyebrow style so it can stand in for a page intro's eyebrow.
 * The last item is the current page: plain text with
 * `aria-current="page"`. Separators are decorative.
 */
interface Props {
  items: NavLink[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="flex flex-wrap items-center gap-x-2 text-eyebrow font-semibold">
    {items.map((item, index) => {
      const isCurrent = index === items.length - 1;
      return (
        <li class="flex items-center gap-x-2">
          {isCurrent ? (
            <span aria-current="page" class="py-1 text-text">
              {item.label}
            </span>
          ) : (
            <>
              <a
                href={item.href}
                class="rounded-sm py-1 text-primary underline-offset-4 hover:underline"
              >
                {item.label}
              </a>
              <span class="text-text-muted" aria-hidden="true">
                /
              </span>
            </>
          )}
        </li>
      );
    })}
  </ol>
</nav>
