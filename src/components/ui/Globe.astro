---
/**
 * Decorative globe (COMPONENT_INVENTORY.md §6, MarketsList, C-07), the
 * same drawing as the Home Global Presence section (which still has its
 * own inline copy). Latitude and longitude lines only, with no land, pins,
 * routes or labels, so it cannot be read as a map of markets served. The
 * Saffron ring is decoration on a light background, never text
 * (BRAND_GUIDELINES.md §3.3). Hidden from assistive technology.
 */
interface Props {
  /** Fill of the soft disc behind the globe; contrast it with the section background */
  haloClass?: string;
  class?: string;
}

const { haloClass = "fill-ivory-deep/60", class: className } = Astro.props;

// Globe geometry in a 400 × 400 viewBox
const c = 200;
const r = 150;
const toRad = (deg: number) => (deg * Math.PI) / 180;

// Meridians as ellipses (0° is the straight central line)
const meridians = [30, 60].map((lon) => r * Math.sin(toRad(lon)));
// Parallels as chords, equator included
const parallels = [-60, -30, 0, 30, 60].map((lat) => ({
  y: c - r * Math.sin(toRad(lat)),
  half: r * Math.cos(toRad(lat)),
}));

// Ring around the globe, split so its back half passes behind the sphere
const ring = { rx: r * 1.24, ry: r * 0.36 };
const ringBack = `M ${c - ring.rx} ${c} A ${ring.rx} ${ring.ry} 0 0 1 ${c + ring.rx} ${c}`;
const ringFront = `M ${c + ring.rx} ${c} A ${ring.rx} ${ring.ry} 0 0 1 ${c - ring.rx} ${c}`;
---

<svg
  viewBox="0 0 400 400"
  class:list={["block text-olive", className]}
  aria-hidden="true"
  focusable="false"
>
  <circle cx={c} cy={c} r={r * 1.3} class={haloClass} />

  <g transform={`rotate(-18 ${c} ${c})`}>
    <path
      d={ringBack}
      fill="none"
      class="stroke-saffron-deep"
      stroke-opacity="0.45"
      stroke-width="2"
    />

    <circle cx={c} cy={c} r={r} class="fill-surface" />

    <g fill="none" stroke="currentColor" stroke-width="1.25">
      <g stroke-opacity="0.28">
        <line x1={c} y1={c - r} x2={c} y2={c + r} />
        {meridians.map((rx) => (
          <ellipse cx={c} cy={c} rx={rx} ry={r} />
        ))}
        {parallels.map(({ y, half }) => (
          <line x1={c - half} y1={y} x2={c + half} y2={y} />
        ))}
      </g>
      <circle cx={c} cy={c} r={r} stroke-opacity="0.7" stroke-width="1.5" />
    </g>

    <path
      d={ringFront}
      fill="none"
      class="stroke-saffron"
      stroke-width="2.5"
      stroke-linecap="round"
    />
  </g>
</svg>
