---
import { Picture } from "astro:assets";
import { ArrowRight } from "lucide-react";

import type { ProductCategory } from "../../data/navigation";

/**
 * Category card (COMPONENT_INVENTORY.md §5), first used on Home (M3.3).
 *
 * The whole card is one link: the visible CTA link is stretched over the
 * card, so each card is a single tab stop with a descriptive name. The
 * category accent (DESIGN_SYSTEM.md §3.4) is the top border only; the rest
 * of the card is identical across categories. Hover lift and image zoom
 * (D-06) need a hover-capable device and are skipped under reduced motion.
 */
interface Props {
  category: ProductCategory;
  description: string;
  examples?: string;
  examplesLabel?: string;
  ctaLabel: string;
  /** Crop focus for the image, as a CSS object-position value */
  imagePosition?: string;
}

const {
  category,
  description,
  examples,
  examplesLabel,
  ctaLabel,
  imagePosition = "50% 50%",
} = Astro.props;

// The last word and the arrow wrap together, so the arrow never sits alone
const splitAt = ctaLabel.lastIndexOf(" ") + 1;
const ctaLead = ctaLabel.slice(0, splitAt);
const ctaLastWord = ctaLabel.slice(splitAt);
---

<article
  class="group/card relative flex h-full flex-col overflow-hidden rounded-lg border border-line bg-surface transition-[translate,box-shadow] duration-(--duration-base) ease-out hover:shadow-card-hover has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-focus motion-safe:hover:translate-y-(--hover-lift)"
  style={`--color-category: var(--color-${category.accent})`}
>
  <span class="h-1 bg-category" aria-hidden="true"></span>

  <div class="relative aspect-4/3 overflow-hidden bg-mist md:aspect-3/2">
    <Picture
      src={category.image}
      alt={category.imageAlt}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={[400, 800, 1200]}
      sizes="(min-width: 1344px) 406px, (min-width: 768px) 31vw, 100vw"
      class="absolute inset-0 size-full object-cover transition-transform duration-(--duration-base) ease-out motion-safe:group-hover/card:scale-(--hover-zoom)"
      style={`object-position: ${imagePosition}`}
    />
  </div>

  <div class="flex flex-1 flex-col p-6 md:p-5 lg:p-8">
    <h3 class="text-h3 font-semibold text-ink">{category.label}</h3>

    <p class="mt-3 text-text">{description}</p>

    {examples && (
      <div class="mt-5 border-t border-line pt-4">
        {examplesLabel && (
          <p class="text-eyebrow font-semibold text-text-muted">
            {examplesLabel}
          </p>
        )}
        <p class="mt-2 text-small text-text-muted">{examples}</p>
      </div>
    )}

    <!-- Not flex: on narrow cards the arrow wraps with the last word -->
    <a
      href={category.href}
      class="mt-auto min-h-11 self-start pt-6 text-button font-semibold text-primary underline-offset-4 group-hover/card:underline after:absolute after:inset-0 after:content-[''] focus-visible:underline focus-visible:outline-none"
    >
      {ctaLead}
      <span class="whitespace-nowrap">
        {ctaLastWord}
        <ArrowRight
          className="ml-1.5 inline size-4 align-[-0.1875em] transition-transform duration-(--duration-base) ease-out motion-safe:group-hover/card:translate-x-0.5"
          strokeWidth={1.75}
          aria-hidden="true"
        />
      </span>
    </a>
  </div>
</article>
