---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";

/**
 * Product card (COMPONENT_INVENTORY.md §5), first used on Home (M3.5).
 *
 * Image (4:3) and product name only: there are no product pages (SITE_STRUCTURE.md
 * §2), so the card is not a link. The WhatsApp enquiry button joins the card
 * once the number is confirmed (C-01, C-02). The category accent is a short
 * mark under the name (DESIGN_SYSTEM.md §3.4). Image zoom and card lift (D-06)
 * need a hover-capable device and are skipped under reduced motion.
 */
interface Props {
  product: CollectionEntry<"products">["data"];
  /** Image `sizes` for the layout the card sits in */
  sizes: string;
}

const { product, sizes } = Astro.props;
---

<article class="group/card flex h-full flex-col overflow-hidden rounded-lg border border-line bg-surface transition-[translate,box-shadow] duration-(--duration-base) ease-out hover:shadow-card-hover motion-safe:hover:translate-y-(--hover-lift)">
  <div class="relative aspect-4/3 overflow-hidden bg-ivory-deep">
    <Picture
      src={product.image}
      alt={product.imageAlt}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={[product.image.width]}
      sizes={sizes}
      class="absolute inset-0 size-full object-cover transition-transform duration-(--duration-base) ease-out motion-safe:group-hover/card:scale-(--hover-zoom)"
    />
  </div>

  <div class="flex flex-1 flex-col px-5 pt-4 pb-5">
    <h3 class="text-h4 font-semibold text-charcoal">{product.name}</h3>
    <span class="mt-3 h-0.5 w-8 bg-category" aria-hidden="true"></span>
  </div>
</article>
