---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";

/**
 * Product card (COMPONENT_INVENTORY.md §5), first used on Home (M3.5).
 *
 * Image (4:3) and product name only: there are no product pages (SITE_STRUCTURE.md
 * §2), so the card is not a link. The category accent is a short mark under
 * the name (DESIGN_SYSTEM.md §3.4). Below sm the optional description is
 * hidden so two-column grids stay compact (D-24). Image zoom and card lift
 * (D-06) need a hover-capable device and are skipped under reduced motion.
 */
interface Props {
  product: CollectionEntry<"products">["data"];
  /** Image `sizes` for the layout the card sits in */
  sizes: string;
  /** 4 when the card sits under a category `h3` (Products Overview portfolio) */
  headingLevel?: 3 | 4;
  /** Short label above the name, such as the spice's form (Spices page) */
  label?: string;
  /** Short description under the name (Spices page) */
  description?: string;
}

const { product, sizes, headingLevel = 3, label, description } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<article class="group/card flex h-full flex-col overflow-hidden rounded-lg border border-line bg-surface transition-[translate,box-shadow] duration-(--duration-base) ease-out hover:shadow-card-hover motion-safe:hover:translate-y-(--hover-lift)">
  <div class="relative aspect-4/3 overflow-hidden bg-mist">
    <Picture
      src={product.image}
      alt={product.imageAlt}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={[product.image.width]}
      sizes={sizes}
      class="absolute inset-0 size-full object-cover transition-transform duration-(--duration-base) ease-out motion-safe:group-hover/card:scale-(--hover-zoom)"
    />
  </div>

  <div class="flex flex-1 flex-col px-4 pt-4 pb-4 sm:px-5 sm:pb-5">
    {label && (
      <p class="mb-2 text-eyebrow font-semibold text-text-muted">{label}</p>
    )}
    <Heading class="text-h4 font-semibold text-ink">{product.name}</Heading>
    <span class="mt-3 h-0.5 w-8 bg-category" aria-hidden="true"></span>
    {description && (
      <p class="mt-4 text-small text-text-muted max-sm:hidden">{description}</p>
    )}
    <!-- Card actions, such as an enquiry link, pinned to the card's foot -->
    {Astro.slots.has("default") && (
      <div class="mt-auto pt-4 text-small [&_a]:whitespace-nowrap">
        <slot />
      </div>
    )}
  </div>
</article>
