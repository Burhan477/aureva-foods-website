---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

import Button from "../ui/Button.astro";
import PendingContent from "../ui/PendingContent.astro";
import WhatsAppButton from "../ui/WhatsAppButton.astro";

/**
 * Business Enquiry CTA (COMPONENT_INVENTORY.md §6, M3.10), the last section
 * before the footer on every page except legal pages.
 *
 * Inverse (olive) band (DESIGN_SYSTEM.md §11) with the two approved CTAs:
 * WhatsApp Us as Primary and Request a Quote as Secondary, dark variants
 * (§9.1). The footer below is olive too, so an Ivory hairline closes the
 * band. Saffron is used only on olive: eyebrow, rule and focus ring
 * (BRAND_GUIDELINES.md §3.3). Heading and buttons stack below lg and sit
 * side by side from lg. Content reveals once (§14) and stays visible
 * without JavaScript and under reduced motion.
 *
 * Options, added for About Us (M5.1); the defaults render Home unchanged:
 * - `tone: "charcoal"`: Charcoal band instead of olive (owner request,
 *   2026-10-26). Ivory and Saffron keep their contrast on it (13.05 and
 *   8.89, BRAND_GUIDELINES.md §3.2).
 * - `image`: an ingredient photo in the right 5 columns from lg, with the
 *   heading and buttons stacked on the left; last below lg.
 * - `topics`: short enquiry topics, listed under the buttons; `note` is
 *   optional when they are given.
 */
interface Props {
  content: {
    eyebrow: string;
    title: string;
    intro: string;
    note?: string;
    topics?: string[];
    /** Accessible name for the topics list */
    topicsLabel?: string;
    quote: { href: string | null; pendingNote: string };
  };
  tone?: "olive" | "charcoal";
  image?: { src: ImageMetadata; alt: string };
}

const { content, tone = "olive", image } = Astro.props;
const { quote } = content;

const background = tone === "charcoal" ? "bg-charcoal" : "bg-inverse";
const gridLayout = image ? "lg:gap-x-16 lg:gap-y-8" : "lg:items-end lg:gap-16";
const headingColumn = image ? "lg:col-span-7 lg:self-end" : "lg:col-span-7";
const actionsColumn = image
  ? "lg:col-span-7 lg:row-start-2 lg:self-start"
  : "lg:col-span-5";
---

<section
  aria-labelledby="enquiry-title"
  class={`relative overflow-hidden ${background} text-text-inverse [--color-focus:var(--color-saffron)]`}
>
  <!-- Soft depth from the approved deep olive; decorative -->
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_85%_0%,var(--color-olive-deep),transparent_60%)]"
    aria-hidden="true"
  ></div>

  <div class="relative container-wide">
    <div
      class={`grid gap-10 border-b border-ivory/15 py-section lg:grid-cols-12 ${gridLayout}`}
    >
      <div class={headingColumn} data-reveal>
        <p class="flex items-center gap-3 text-eyebrow font-semibold text-saffron uppercase">
          <span class="h-px w-8 bg-saffron" aria-hidden="true"></span>
          {content.eyebrow}
        </p>

        <h2
          id="enquiry-title"
          class="mt-5 font-display text-h2 text-balance text-ivory"
        >
          {content.title}
        </h2>

        <p class="mt-6 max-w-[60ch] text-lead text-ivory/90">{content.intro}</p>
      </div>

      <div class={actionsColumn} data-reveal>
        <div class="flex flex-wrap gap-3 sm:gap-4">
          <WhatsAppButton tone="dark" size="lg" />

          {quote.href ? (
            <Button href={quote.href} variant="secondary" tone="dark" size="lg">
              Request a Quote
            </Button>
          ) : (
            <button
              type="button"
              aria-disabled="true"
              class="inline-flex min-h-13 shrink-0 cursor-not-allowed items-center justify-center rounded-md border-[1.5px] border-ivory px-7 text-body font-semibold whitespace-nowrap text-ivory opacity-60"
            >
              Request a Quote
              <span class="sr-only">(not available yet)</span>
            </button>
          )}
        </div>

        {content.topics && (
          <ul
            aria-label={content.topicsLabel}
            class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-small text-ivory/80"
          >
            {content.topics.map((topic, index) => (
              <li class="flex items-center gap-3">
                {index > 0 && (
                  <span
                    class="size-1 rounded-full bg-saffron"
                    aria-hidden="true"
                  />
                )}
                {topic}
              </li>
            ))}
          </ul>
        )}

        {content.note && (
          <p class="mt-6 max-w-[48ch] border-l-2 border-saffron pl-4 text-ivory/80">
            {content.note}
          </p>
        )}

        <PendingContent
          item="M5.3, C-02"
          note={quote.pendingNote}
          class="mt-6"
        />
      </div>

      {image && (
        <div
          class="lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 lg:self-center"
          data-reveal
        >
          <!-- `sizes` assumes a 16:9 photo, which fills the 4:3 frame at
               about 1.33 times its width -->
          <div class="relative aspect-4/3 overflow-hidden rounded-lg bg-olive-deep">
            <Picture
              src={image.src}
              alt={image.alt}
              formats={["avif", "webp"]}
              fallbackFormat="jpg"
              widths={[480, 800, 1200, image.src.width]}
              sizes="(min-width: 1344px) 661px, (min-width: 1024px) 52vw, 134vw"
              class="absolute inset-0 size-full object-cover"
            />
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  import "../../scripts/reveal";
</script>
