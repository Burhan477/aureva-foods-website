---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

import Button from "../ui/Button.astro";
import PendingContent from "../ui/PendingContent.astro";
import WhatsAppButton from "../ui/WhatsAppButton.astro";

/**
 * Business Enquiry CTA (COMPONENT_INVENTORY.md §6), the last section before
 * the footer on every page except legal pages.
 *
 * A rounded noir panel inside the page container (DESIGN_SYSTEM.md §11,
 * D-24), so it stays distinct from the noir footer below. The two approved
 * CTAs use their dark variants (§9.1): WhatsApp Us as Primary, Request a
 * Quote as Secondary. Emerald is the only accent on noir. Heading and
 * buttons stack below lg and sit side by side from lg. Content reveals
 * once (§14) and stays visible without JavaScript and under reduced motion.
 *
 * Options:
 * - `image`: an ingredient photo in the right 5 columns from lg, with the
 *   heading and buttons stacked on the left; last below lg.
 * - `topics`: short enquiry topics, listed under the buttons.
 * - `id`: the section's id, for in-page links.
 * - `whatsappMessage`: an approved site.ts template for WhatsApp Us
 *   instead of the general message.
 */
interface Props {
  content: {
    title: string;
    intro: string;
    note?: string;
    topics?: string[];
    /** Accessible name for the topics list */
    topicsLabel?: string;
    quote: { href: string | null; pendingNote?: string };
  };
  image?: { src: ImageMetadata; alt: string };
  id?: string;
  whatsappMessage?: string;
}

const { content, image, id, whatsappMessage } = Astro.props;
const { quote } = content;

const gridLayout = image ? "lg:gap-x-16 lg:gap-y-8" : "lg:items-end lg:gap-16";
const headingColumn = image ? "lg:col-span-7 lg:self-end" : "lg:col-span-7";
const actionsColumn = image
  ? "lg:col-span-7 lg:row-start-2 lg:self-start"
  : "lg:col-span-5 lg:justify-self-end";
---

<section id={id} aria-labelledby="enquiry-title" class="bg-bg py-section-tight">
  <div class="container-wide">
    <div
      class={`grid gap-10 rounded-2xl bg-inverse px-6 py-12 text-text-inverse [--color-focus:var(--color-accent)] sm:px-10 sm:py-14 lg:grid-cols-12 lg:px-14 lg:py-16 ${gridLayout}`}
    >
      <div class={headingColumn} data-reveal>
        <h2
          id="enquiry-title"
          class="font-display text-h2 text-balance text-white"
        >
          {content.title}
        </h2>

        <p class="mt-5 max-w-[56ch] text-lead text-mist/85">{content.intro}</p>
      </div>

      <div class={actionsColumn} data-reveal>
        <div class="flex flex-wrap gap-3">
          <WhatsAppButton tone="dark" size="lg" message={whatsappMessage} />

          {quote.href ? (
            <Button href={quote.href} variant="secondary" tone="dark" size="lg">
              Request a Quote
            </Button>
          ) : (
            <button
              type="button"
              aria-disabled="true"
              class="inline-flex min-h-13 shrink-0 cursor-not-allowed items-center justify-center rounded-md border border-mist/40 px-7 text-body font-semibold whitespace-nowrap text-mist opacity-60"
            >
              Request a Quote
              <span class="sr-only">(not available yet)</span>
            </button>
          )}
        </div>

        {content.topics && (
          <ul
            aria-label={content.topicsLabel}
            class="mt-6 flex flex-wrap gap-2 text-small text-mist/85"
          >
            {content.topics.map((topic) => (
              <li class="rounded-full border border-mist/20 px-3 py-1">
                {topic}
              </li>
            ))}
          </ul>
        )}

        {content.note && (
          <p class="mt-6 max-w-[48ch] text-small text-mist/75">
            {content.note}
          </p>
        )}

        {!quote.href && quote.pendingNote && (
          <PendingContent item="M5.3" note={quote.pendingNote} class="mt-6" />
        )}
      </div>

      {image && (
        <div
          class="lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 lg:self-center"
          data-reveal
        >
          <!-- `sizes` assumes a 16:9 photo, which fills the 4:3 frame at
               about 1.33 times its width -->
          <div class="relative aspect-4/3 overflow-hidden rounded-lg bg-ink">
            <Picture
              src={image.src}
              alt={image.alt}
              formats={["avif", "webp"]}
              fallbackFormat="jpg"
              widths={[480, 800, 1200, image.src.width]}
              sizes="(min-width: 1344px) 560px, (min-width: 1024px) 44vw, 120vw"
              class="absolute inset-0 size-full object-cover"
            />
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  import "../../scripts/reveal";
</script>
