---
import { productRange as section } from "../../../data/about";
import { productCategories } from "../../../data/navigation";
import CategoryCard from "../../product/CategoryCard.astro";
import SectionHeader from "../../ui/SectionHeader.astro";

/**
 * About Us "Our Product Range" (SITE_STRUCTURE.md §4.2 section 3).
 *
 * Alternate background after the white introduction (DESIGN_SYSTEM.md
 * §11). CategoryCard: 1 column, 3 from md (§6.2), linking to the approved
 * category routes (D-10). Product lists live on the category pages only
 * (D-24). Cards reveal once with an 80 ms stagger (§14).
 */

/** Crop focus per image: the fresh produce photo leans left, away from the off-catalogue tomatoes */
const imagePositions: Partial<Record<string, string>> = {
  "fresh-fruits-vegetables": "35% 50%",
};
---

<section aria-labelledby="product-range-title" class="bg-bg-alt py-section">
  <div class="container-wide">
    <SectionHeader
      id="product-range-title"
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <ul class="mt-12 grid gap-6 md:grid-cols-3 lg:mt-14 lg:gap-8">
      {productCategories.map((category) => {
        const copy = section.cards[category.id];
        return (
          <li data-reveal>
            <CategoryCard
              category={category}
              description={copy.description}
              ctaLabel={copy.ctaLabel}
              imagePosition={imagePositions[category.id]}
            />
          </li>
        );
      })}
    </ul>
  </div>
</section>
