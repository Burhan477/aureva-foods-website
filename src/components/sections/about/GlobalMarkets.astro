---
import { Container, Factory, Network, Store } from "lucide-react";

import {
  type BuyerSegment,
  globalMarkets as section,
} from "../../../data/about";
import PendingContent from "../../ui/PendingContent.astro";
import SectionHeader from "../../ui/SectionHeader.astro";

/**
 * About Us "Global Markets", shown as "Who We Work With"
 * (SITE_STRUCTURE.md §4.2 section 6, C-07).
 *
 * Markets served are not confirmed (C-07), so the section names buyer
 * types only; confirmed markets appear as a list once `markets` is filled
 * in data/about.ts. Heading block, then the four buyer types in a row
 * (1 column, 2 from sm, 4 from lg) with an icon each. The closing enquiry
 * card and the globe were removed under D-24, because the page's enquiry
 * CTA follows directly. Reveals once (§14).
 */

const icons: Record<BuyerSegment["id"], typeof Store> = {
  importers: Container,
  distributors: Network,
  manufacturers: Factory,
  wholesalers: Store,
};
---

<section aria-labelledby="global-markets-title" class="bg-bg py-section">
  <div class="container-wide">
    <SectionHeader
      id="global-markets-title"
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <ul class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4">
      {section.segments.map((segment) => {
        const Icon = icons[segment.id];
        return (
          <li class="border-t border-line pt-6" data-reveal>
            <span
              class="flex size-10 items-center justify-center rounded-md bg-primary/10 text-primary"
              aria-hidden="true"
            >
              <Icon className="size-5" strokeWidth={1.75} />
            </span>
            <h3 class="mt-5 text-h4 font-semibold text-ink">{segment.title}</h3>
            <p class="mt-2 text-small text-text-muted">{segment.text}</p>
          </li>
        );
      })}
    </ul>

    {section.markets.length > 0 ? (
      <div class="mt-12" data-reveal>
        <p id="global-markets-list" class="text-small font-semibold text-ink">
          {section.marketsLabel}
        </p>
        <ul
          aria-labelledby="global-markets-list"
          class="mt-3 flex flex-wrap gap-2"
        >
          {section.markets.map((market) => (
            <li class="rounded-full border border-line px-3 py-1 text-small text-ink">
              {market}
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <PendingContent
        item="C-07"
        note="Markets served are not confirmed, so no country, region or map is shown. Add confirmed markets to globalMarkets.markets in data/about.ts once the owner says which may be named publicly."
        class="mt-12"
      />
    )}
  </div>
</section>
