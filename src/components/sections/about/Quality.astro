---
import { Picture } from "astro:assets";
import { ClipboardList, Files, HandPlatter, Handshake } from "lucide-react";

import dehydratedImage from "../../../assets/images/categories/dehydrated-products.webp";
import { type QualityPrinciple, quality as section } from "../../../data/about";
import ComplianceList from "../ComplianceList.astro";

/**
 * About Us "Quality Standards & Certifications", shown as "Our Commitment
 * to Quality" (SITE_STRUCTURE.md §4.2 section 5, C-05).
 *
 * Image + text split on the alternate background: the photo in the left
 * 5 columns from lg, the intro and four principles (2 × 2, icon on a light
 * emerald tile) on the right. Icons are neutral document marks, never
 * ticks, shields or badges that could read as a certification. Verified
 * credentials come from site.ts through ComplianceList. Reveals once (§14).
 */

const icons: Record<QualityPrinciple["id"], typeof Files> = {
  specifications: ClipboardList,
  "food-safety": HandPlatter,
  documentation: Files,
  partnerships: Handshake,
};
---

<section aria-labelledby="quality-title" class="bg-bg-alt py-section">
  <div class="container-wide grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
    <div
      class="relative aspect-4/3 overflow-hidden rounded-2xl bg-mist lg:col-span-5 lg:aspect-4/5"
      data-reveal
    >
      <!-- The 16:9 source fills the frame at about 1.33 times its width -->
      <Picture
        src={dehydratedImage}
        alt={section.imageAlt}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        widths={[480, 800, 1200, dehydratedImage.width]}
        sizes="(min-width: 1344px) 900px, (min-width: 1024px) 70vw, 134vw"
        class="absolute inset-0 size-full object-cover"
      />
    </div>

    <div class="lg:col-span-7" data-reveal>
      <p class="text-eyebrow font-semibold text-primary">{section.eyebrow}</p>

      <h2
        id="quality-title"
        class="mt-4 font-display text-h2 text-balance text-heading"
      >
        {section.title}
      </h2>

      <p class="mt-5 max-w-[56ch] text-lead text-text-muted">{section.intro}</p>

      <ul class="mt-10 grid gap-8 sm:grid-cols-2">
        {section.principles.map((principle) => {
          const Icon = icons[principle.id];
          return (
            <li class="flex gap-4">
              <span
                class="flex size-10 shrink-0 items-center justify-center rounded-md bg-primary/10 text-primary"
                aria-hidden="true"
              >
                <Icon className="size-5" strokeWidth={1.75} />
              </span>
              <div>
                <h3 class="font-semibold text-ink">{principle.title}</h3>
                <p class="mt-1 text-small text-text-muted">{principle.text}</p>
              </div>
            </li>
          );
        })}
      </ul>

      <ComplianceList class="mt-10" />
    </div>
  </div>
</section>
