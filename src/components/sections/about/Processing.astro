---
import { Picture } from "astro:assets";

import heroImage from "../../../assets/images/hero/home-hero.webp";
import { processing as section } from "../../../data/about";

/**
 * About Us "Manufacturing & Processing Capabilities", shown as "Our
 * Processing Approach" (SITE_STRUCTURE.md §4.2 section 4, C-08).
 *
 * Text + image split on white, then the four preparation steps as a
 * numbered row divided by hairlines rather than cards (D-24): 1 column,
 * 2 from sm, 4 from lg. The copy hedges every step on confirmed supplier
 * capabilities (C-08). Reveals once (§14).
 */
---

<section aria-labelledby="processing-title" class="bg-bg py-section">
  <div class="container-wide">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <p class="text-eyebrow font-semibold text-primary">{section.eyebrow}</p>

        <h2
          id="processing-title"
          class="mt-4 font-display text-h2 text-balance text-heading"
        >
          {section.title}
        </h2>

        <p class="mt-5 max-w-[56ch] text-lead text-text-muted">
          {section.intro}
        </p>
      </div>

      <div
        class="relative aspect-4/3 overflow-hidden rounded-2xl bg-mist lg:col-span-7"
        data-reveal
      >
        <Picture
          src={heroImage}
          alt={section.imageAlt}
          formats={["avif", "webp"]}
          fallbackFormat="jpg"
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1344px) 720px, (min-width: 1024px) 54vw, 100vw"
          class="absolute inset-0 size-full object-cover object-[80%_55%]"
        />
      </div>
    </div>

    <ol class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4">
      {section.capabilities.map((capability, index) => (
        <li class="border-t border-line pt-6" data-reveal>
          <!-- The list already conveys the order to assistive technology -->
          <span
            class="text-small font-semibold text-primary tabular-nums"
            aria-hidden="true"
          >
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3 class="mt-3 text-h4 font-semibold text-ink">
            {capability.title}
          </h3>
          <p class="mt-2 text-small text-text-muted">{capability.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
