---
import { Picture } from "astro:assets";

import freshImage from "../../../assets/images/categories/fresh-fruits-vegetables.jpg";
import { whoWeAre as section } from "../../../data/about";

/**
 * About Us "Who We Are" (SITE_STRUCTURE.md §4.2 section 2, M5.1).
 *
 * Text + image split (DESIGN_SYSTEM.md §6.2), mirroring Company
 * Introduction: 6 / 6 columns from lg with the image on the left. Below lg
 * it stacks with the text first, so on phones text and photos alternate
 * down the page instead of two photos meeting at the section boundary.
 * Alternate background after the Ivory introduction (§11).
 *
 * The photo is the Fresh category image. Its crop keeps the tomatoes on
 * the right edge out of frame: left-aligned at 4:3, centred at 1:1. Leaf
 * Green is used only on the decorative offset frame, because it is the
 * Fresh accent and is 4.0:1 on Ivory Deep, too low for small text
 * (BRAND_GUIDELINES.md §3). Copy and image reveal once (§14); visible
 * without JavaScript and under reduced motion.
 */
---

<section aria-labelledby="who-we-are-title" class="bg-bg-alt py-section">
  <div class="container-wide grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-6" data-reveal>
      <p class="flex items-center gap-3 text-eyebrow font-semibold text-olive uppercase">
        <span class="h-px w-8 bg-olive" aria-hidden="true"></span>
        {section.eyebrow}
      </p>

      <h2
        id="who-we-are-title"
        class="mt-5 font-display text-h2 text-balance text-heading"
      >
        {section.title}
      </h2>

      {section.paragraphs.map((paragraph, index) => (
        <p
          class:list={[
            "max-w-[68ch]",
            index === 0 ? "mt-6 text-lead text-text" : "mt-5 text-text-muted",
          ]}
        >
          {paragraph}
        </p>
      ))}

      <p class="mt-8 border-l-2 border-saffron pl-5 text-h4 font-semibold text-olive">
        {section.statement}
      </p>
    </div>

    <div class="lg:order-first lg:col-span-6" data-reveal>
      <!-- Offset outline frame: decorative, from lg only -->
      <div class="relative lg:mr-4 lg:mb-4">
        <div
          class="absolute inset-0 hidden translate-x-4 translate-y-4 rounded-lg border border-leaf/40 lg:block"
          aria-hidden="true"
        ></div>
        <div class="relative aspect-4/3 overflow-hidden rounded-lg bg-ivory lg:aspect-square">
          <Picture
            src={freshImage}
            alt={section.imageAlt}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            widths={[480, 800, 1200, freshImage.width]}
            sizes="(min-width: 1344px) 592px, (min-width: 1024px) 45vw, 100vw"
            class="absolute inset-0 size-full object-cover object-left lg:object-center"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import "../../../scripts/reveal";
</script>
