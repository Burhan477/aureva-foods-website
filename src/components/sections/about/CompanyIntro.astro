---
import { Picture } from "astro:assets";

import aboutImage from "../../../assets/images/sections/home-about.webp";
import { companyIntro as section } from "../../../data/about";

/**
 * About Us "Company Introduction" (SITE_STRUCTURE.md §4.2 section 1), the
 * page hero; Who We Are is folded into this copy (D-24). Same layout as
 * the Home hero (owner request, 2026-10-27): the photo is the section
 * background. Below xl it sits under the text and fades up into the page;
 * from xl it fills the section with a white wash on the text side, so the
 * copy never sits on the busy part of the photo (DESIGN_SYSTEM.md §12).
 *
 * The image is the LCP element: eager, high priority, and never hidden by
 * a reveal animation (DESIGN_SYSTEM.md §14). No client JavaScript.
 * On load the text block enters and the photo settles (CSS, §14).
 */
---

<section
  aria-labelledby="company-intro-title"
  class="relative isolate flex flex-col overflow-hidden bg-bg xl:min-h-[clamp(34rem,calc(100svh-var(--header-height)),40rem)] xl:justify-center"
>
  <div class="container-wide pt-12 sm:pt-16 xl:py-section-tight">
    <!-- Wide enough for the heading to sit on two lines from xl -->
    <div class="max-w-xl xl:max-w-152" data-enter>
      <p class="text-eyebrow font-semibold text-primary">{section.eyebrow}</p>

      <h1
        id="company-intro-title"
        class="mt-4 font-display text-h1 text-balance text-heading"
      >
        {section.title}
      </h1>

      {section.paragraphs.map((paragraph, index) => (
        <p
          class:list={[
            "max-w-[52ch] xl:max-w-[46ch]",
            index === 0 ? "mt-6 text-lead text-text" : "mt-4 text-text-muted",
          ]}
        >
          {paragraph}
        </p>
      ))}
    </div>
  </div>

  <div class="relative -z-10 mt-2 aspect-4/3 sm:-mt-4 sm:aspect-video lg:aspect-21/9 xl:absolute xl:inset-0 xl:mt-0 xl:aspect-auto">
    <Picture
      src={aboutImage}
      alt={section.imageAlt}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={[640, 960, 1280, aboutImage.width]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      data-enter-image
      class="absolute inset-0 size-full object-cover object-[60%_50%] xl:object-[80%_50%]"
    />
    <!-- Fades the photo into the page: from the top below xl, from the
         text side from xl -->
    <div
      class="absolute inset-0 bg-linear-to-b from-bg to-bg/0 to-40% xl:bg-linear-to-r xl:from-bg xl:from-38% xl:via-bg/85 xl:via-52% xl:to-bg/0 xl:to-75%"
      aria-hidden="true"
    ></div>
  </div>
</section>
