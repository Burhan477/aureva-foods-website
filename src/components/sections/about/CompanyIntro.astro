---
import { Picture } from "astro:assets";

import aboutImage from "../../../assets/images/sections/home-about.jpg";
import { companyIntro as section } from "../../../data/about";

/**
 * About Us "Company Introduction" (SITE_STRUCTURE.md §4.2 section 1), the
 * page hero. Text + image split on white (6 / 6 from lg, image below the
 * text on smaller screens); Who We Are is folded into this copy (D-24).
 * The image is the LCP element, so it loads eagerly and is never hidden by
 * a reveal.
 */
---

<section
  aria-labelledby="company-intro-title"
  class="bg-bg pt-10 pb-section sm:pt-14 lg:pt-12"
>
  <div class="container-wide grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-6">
      <p class="text-eyebrow font-semibold text-primary">{section.eyebrow}</p>

      <h1
        id="company-intro-title"
        class="mt-4 font-display text-h1 text-balance text-heading"
      >
        {section.title}
      </h1>

      {section.paragraphs.map((paragraph, index) => (
        <p
          class:list={[
            "max-w-[56ch]",
            index === 0 ? "mt-6 text-lead text-text" : "mt-4 text-text-muted",
          ]}
        >
          {paragraph}
        </p>
      ))}
    </div>

    <div class="relative aspect-4/3 overflow-hidden rounded-2xl bg-mist lg:col-span-6 lg:aspect-5/4">
      <Picture
        src={aboutImage}
        alt={section.imageAlt}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        widths={[480, 800, 1200, aboutImage.width]}
        sizes="(min-width: 1344px) 616px, (min-width: 1024px) 46vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 size-full object-cover"
      />
    </div>
  </div>
</section>
