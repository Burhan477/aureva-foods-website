---
import { specifications as section } from "../../../data/dehydrated-products";
import Button from "../../ui/Button.astro";
import SectionHeader from "../../ui/SectionHeader.astro";

/**
 * Dehydrated Products "Product Range & Specifications"
 * (SITE_STRUCTURE.md §4.5 section 5), following the Spices section of
 * the same name. BLOCKED on data (C-11), so every row is an enquiry
 * topic; see data/dehydrated-products.ts.
 *
 * Ivory band after the alternate Vegetable & Other Powders section
 * (DESIGN_SYSTEM.md §11), with the Dehydrated accent, Saffron (D-09), on
 * rules and markers only (§3.4). Three parts:
 *
 * - The three product groups as white text cards, not product cards, so
 *   the section does not repeat Sections 2 to 4. Products come from
 *   products.json by group. No photos: every dehydrated image already
 *   appears on this page. From lg the cards sit 3 / 3 / 6 columns so the
 *   eight powders list in two columns; from sm the powders card spans
 *   the full row under the other two.
 * - The Specification Checklist as a real table (COMPONENT_INVENTORY.md
 *   §5, SpecificationTable) of topic and what to discuss. Two columns
 *   fit a phone without scrolling sideways; the frame still scrolls if
 *   it ever must.
 * - The Buyer Enquiry Process in a Deep Olive panel with Saffron step
 *   numbers (§3.1: accent text on Deep Olive) and the dark-tone Request a
 *   Quote button, focus ring in Saffron, as on the Spices page. The
 *   visible numbers are decorative; the `ol` carries the order.
 *
 * Blocks reveal once (§14) and stay visible under reduced motion. No
 * hover effects: nothing here is a link except the CTA.
 */
---

<section
  id={section.id}
  aria-labelledby="dehydrated-specs-title"
  class="bg-bg py-section"
  style="--color-category: var(--color-saffron-deep)"
>
  <div class="container-wide">
    <SectionHeader
      id="dehydrated-specs-title"
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <div class="mt-10 grid gap-12 lg:mt-12 lg:grid-cols-12 lg:gap-12 xl:gap-16">
      <div class="lg:col-span-7" data-reveal>
        <h3
          id="dehydrated-checklist-title"
          class="text-h3 font-semibold text-ink"
        >
          {section.checklist.title}
        </h3>
        <p
          id="dehydrated-checklist-note"
          class="mt-3 max-w-[60ch] text-text-muted"
        >
          {section.checklist.note}
        </p>

        <div class="mt-6 overflow-x-auto rounded-lg border border-line bg-surface">
          <table
            aria-labelledby="dehydrated-checklist-title"
            aria-describedby="dehydrated-checklist-note"
            class="w-full border-collapse text-left"
          >
            <thead class="border-b border-line bg-mist/50">
              <tr class="text-eyebrow font-semibold text-text-muted">
                <th scope="col" class="w-2/5 px-4 py-3 sm:w-[35%] sm:px-5">
                  {section.checklist.columns.label}
                </th>
                <th scope="col" class="px-4 py-3 sm:px-5">
                  {section.checklist.columns.text}
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {section.checklist.rows.map((row) => (
                <tr>
                  <th
                    scope="row"
                    class="px-4 py-4 align-top font-semibold text-ink sm:px-5"
                  >
                    {row.label}
                  </th>
                  <td class="px-4 py-4 align-top text-text sm:px-5">
                    {row.text}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="lg:col-span-5" data-reveal>
        <!-- Stays in view beside the longer table from lg -->
        <div class="rounded-lg bg-inverse p-6 text-text-inverse [--color-focus:var(--color-accent)] sm:p-8 lg:sticky lg:top-[calc(var(--header-height)+2rem)] lg:p-10">
          <h3 class="text-h3 font-semibold text-mist">
            {section.process.title}
          </h3>

          <ol class="mt-6 divide-y divide-mist/15">
            {section.process.steps.map((step, index) => (
              <li class="grid grid-cols-[3rem_1fr] gap-x-4 py-6 last:pb-0">
                <span
                  class="font-display text-h2 leading-none text-accent"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div>
                  <h4 class="text-h4 font-semibold text-mist">{step.title}</h4>
                  <p class="mt-2 text-mist/85">{step.text}</p>
                </div>
              </li>
            ))}
          </ol>

          <Button
            href={section.process.cta.href}
            tone="dark"
            size="lg"
            class="mt-8 w-full sm:w-auto"
          >
            {section.process.cta.label}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import "../../../scripts/reveal";
</script>
