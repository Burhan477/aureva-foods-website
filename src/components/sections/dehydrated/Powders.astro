---
import { getCollection } from "astro:content";
import { ArrowRight } from "lucide-react";

import { powders as section } from "../../../data/dehydrated-products";
import ProductCard from "../../product/ProductCard.astro";
import SectionHeader from "../../ui/SectionHeader.astro";

/**
 * Dehydrated Products "Vegetable & Other Powders" (SITE_STRUCTURE.md
 * §4.5 section 4), following Dehydrated Onion Products.
 *
 * The eight products in the "Vegetable & Other Powders" group of
 * products.json (§5.2), in catalogue order, each with its provisional
 * description and an Enquire About Product link
 * (data/dehydrated-products.ts). Alternate Ivory band after the Ivory
 * Dehydrated Garlic section (DESIGN_SYSTEM.md §11), with the Dehydrated
 * accent, Saffron (D-09), on the eyebrow rule and card marks only (§3.4).
 * Product grid as on Spices (§6.2): 1 column below 360 px, 2 on phones
 * and tablets, 4 from lg. No form label: every product is a powder, and
 * the name already says so.
 *
 * Card images are lazy. The heading and grid reveal once (§14) and stay
 * visible under reduced motion.
 */

const items = (await getCollection("products"))
  .filter(({ data }) => data.group === "Vegetable & Other Powders")
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ id, data }) => {
    const description = section.products[id];
    if (!description) {
      throw new Error(`[dehydrated] No powder card copy for "${id}"`);
    }
    return { data, description };
  });

/** Card widths per breakpoint, matching the grid classes below */
const imageSizes =
  "(min-width: 1344px) 296px, (min-width: 1024px) 22vw, (min-width: 360px) 46vw, 100vw";

// The last word and the arrow wrap together, so the arrow never sits alone
const splitAt = section.cta.label.lastIndexOf(" ") + 1;
const ctaLead = section.cta.label.slice(0, splitAt);
const ctaLastWord = section.cta.label.slice(splitAt);
---

<section
  id={section.id}
  aria-labelledby="powders-title"
  class="bg-bg-alt py-section"
  style="--color-category: var(--color-saffron-deep)"
>
  <div class="container-wide">
    <SectionHeader
      id="powders-title"
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <ul
      class="mt-10 grid grid-cols-1 gap-4 min-[22.5rem]:grid-cols-2 sm:gap-6 lg:mt-12 lg:grid-cols-4 lg:gap-8"
      data-reveal
    >
      {items.map(({ data, description }) => (
        <li>
          <ProductCard
            product={data}
            sizes={imageSizes}
            description={description}
          >
            <!-- Negative margins keep the 44 px target without extra space -->
            <a
              href={section.cta.href}
              class="-my-3 inline-block min-h-11 py-3 text-button font-semibold text-primary underline-offset-4 hover:underline focus-visible:underline"
            >
              {ctaLead}
              <span class="whitespace-nowrap">
                {ctaLastWord}
                <span class="sr-only">: {data.name}</span>
                <ArrowRight
                  className="ml-1.5 inline size-4 align-[-0.1875em]"
                  strokeWidth={1.75}
                  aria-hidden="true"
                />
              </span>
            </a>
          </ProductCard>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import "../../../scripts/reveal";
</script>
