---
import { faqs as section } from "../../../data/spices";
import SectionHeader from "../../ui/SectionHeader.astro";
import FAQList from "../FAQList.astro";

/**
 * Spices "FAQs" (SITE_STRUCTURE.md §4.4 section 6). DRAFT-TEMP (C-12);
 * see data/spices.ts.
 *
 * A centred SectionHeader (DESIGN_SYSTEM.md §6.2) above the questions,
 * held to a 3xl reading column. The questions are the shared FAQList
 * (native details / summary, no JavaScript). Both blocks reveal once
 * (§14) and stay visible under reduced motion.
 */
---

<section
  id={section.id}
  aria-labelledby="spice-faqs-title"
  class="bg-bg py-section"
  style="--color-category: var(--color-orange)"
>
  <div class="container-wide">
    <SectionHeader
      id="spice-faqs-title"
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <div class="mx-auto mt-10 max-w-3xl lg:mt-12" data-reveal>
      <FAQList items={section.items} labelledBy="spice-faqs-title" />
    </div>
  </div>
</section>
