---
import { Picture } from "astro:assets";

import bannerImage from "../../../assets/images/hero/products-overview.png";
import { intro as section } from "../../../data/products-overview";

/**
 * Products Overview "Introduction" (SITE_STRUCTURE.md §4.3 section 1), the
 * page hero. Heading block on white, then the owner's banner in a rounded
 * frame inside the container (no fade into the page, D-24). The banner is
 * the LCP element: eager, high priority, never hidden by a reveal.
 */
---

<section aria-labelledby="products-intro-title" class="bg-bg">
  <div class="container-wide pt-10 pb-section-tight sm:pt-14 lg:pt-12">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
      <div class="max-w-3xl">
        <p class="text-eyebrow font-semibold text-primary">{section.eyebrow}</p>

        <h1
          id="products-intro-title"
          class="mt-4 font-display text-h1 text-balance text-heading"
        >
          {section.title}
        </h1>
      </div>

      <p class="max-w-[44ch] text-lead text-text-muted">{section.text}</p>
    </div>

    <div class="relative mt-10 aspect-4/3 overflow-hidden rounded-2xl bg-mist sm:aspect-video lg:mt-12 lg:aspect-5/2">
      <Picture
        src={bannerImage}
        alt={section.imageAlt}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 1344px) 1280px, calc(100vw - 2 * var(--space-gutter))"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 size-full object-cover object-[55%_70%] sm:object-[50%_65%]"
      />
    </div>
  </div>
</section>
