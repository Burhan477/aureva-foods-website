---
import { productCategories } from "../../../data/navigation";
import { categoriesSection as section } from "../../../data/products-overview";
import CategoryCard from "../../product/CategoryCard.astro";
import SectionHeader from "../../ui/SectionHeader.astro";

/**
 * Products Overview "Explore Our Categories" (SITE_STRUCTURE.md §4.3), the
 * first section of the page since the introduction was removed (owner
 * request, 2026-10-27), so its heading is the page h1. White background;
 * cards: 1 column, 3 from md (§6.2), each linking to its category page
 * (D-10). Cards reveal once with an 80 ms stagger (§14).
 */

/** Crop focus per image: the fresh produce photo leans left, away from the off-catalogue tomatoes */
const imagePositions: Partial<Record<string, string>> = {
  "fresh-fruits-vegetables": "35% 50%",
};
---

<section
  aria-labelledby="explore-categories-title"
  class="bg-bg pt-12 pb-section sm:pt-16 lg:pt-20"
>
  <div class="container-wide">
    <SectionHeader
      id="explore-categories-title"
      level={1}
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <ul class="mt-12 grid gap-6 md:grid-cols-3 lg:mt-16 lg:gap-8">
      {productCategories.map((category) => {
        const copy = section.cards[category.id];
        return (
          <li data-reveal>
            <CategoryCard
              category={category}
              description={copy.description}
              ctaLabel={copy.ctaLabel}
              imagePosition={imagePositions[category.id]}
            />
          </li>
        );
      })}
    </ul>
  </div>
</section>
