---
import { getCollection } from "astro:content";
import { ArrowRight } from "lucide-react";

import { productCategories } from "../../../data/navigation";
import { portfolio as section } from "../../../data/products-overview";
import ProductCard from "../../product/ProductCard.astro";
import SectionHeader from "../../ui/SectionHeader.astro";

/**
 * Products Overview "Product Portfolio" (SITE_STRUCTURE.md §4.3).
 *
 * Every product in products.json (D-14), grouped by category in the
 * approved order, with each group's accent on its heading rule and card
 * marks (DESIGN_SYSTEM.md §3.4). Default Ivory background after the
 * alternate categories section (§11). Product grid: 2 columns, 3 from sm,
 * 4 from lg (§6.2). Cards are not links (no product pages); each group
 * links to its category route (D-10).
 *
 * Without JavaScript the three groups show one after another, each under
 * its own `h3`. src/scripts/tabs.ts then shows the tab list and one group
 * at a time, so the page is not one long wall of 27 cards. Images in
 * hidden groups are lazy and load only when their tab opens. The block
 * reveals once (§14) and stays visible under reduced motion.
 */

const products = (await getCollection("products")).sort(
  (a, b) => a.data.order - b.data.order,
);

const groups = productCategories.map((category) => ({
  category,
  products: products.filter(({ data }) => data.category === category.id),
}));

/** Card widths per breakpoint, matching the grid classes below */
const imageSizes =
  "(min-width: 1344px) 296px, (min-width: 1024px) 22vw, (min-width: 640px) 30vw, 46vw";

const fill = (template: string, key: string, value: string | number) =>
  template.replace(`{${key}}`, String(value));
---

<section
  id="product-portfolio"
  aria-labelledby="portfolio-title"
  class="bg-bg-alt py-section"
>
  <div class="container-wide">
    <SectionHeader
      id="portfolio-title"
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <div class="mt-10 lg:mt-12" data-tabs data-reveal>
      <div
        role="tablist"
        aria-label={section.tabsLabel}
        class="flex flex-wrap gap-2"
        data-tabs-list
        hidden
      >
        {groups.map(({ category, products: items }, index) => (
          <button
            type="button"
            role="tab"
            id={`${category.id}-tab`}
            aria-controls={`${category.id}-products`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            class="inline-flex min-h-11 items-center gap-2 rounded-full border border-line bg-surface px-4 text-button font-medium text-ink transition-colors duration-(--duration-fast) ease-out hover:border-ink/40 aria-selected:border-ink aria-selected:bg-ink aria-selected:text-white"
            data-tab
          >
            {category.label}
            <span class="text-small font-medium opacity-80">
              {items.length}
              <span class="sr-only"> products</span>
            </span>
          </button>
        ))}
      </div>

      {groups.map(({ category, products: items }) => (
        <div
          id={`${category.id}-products`}
          class="mt-10 lg:mt-12"
          style={`--color-category: var(--color-${category.accent})`}
          data-tab-panel
        >
          <div class="relative flex flex-wrap items-end justify-between gap-x-6 gap-y-2 border-b border-line pb-4">
            <div>
              <h3 class="text-h3 font-semibold text-ink">{category.label}</h3>
              <p class="mt-1 text-small text-text-muted">
                {fill(section.countLabel, "count", items.length)}
              </p>
            </div>

            <a
              href={category.href}
              class="inline-flex min-h-11 items-center gap-1.5 text-button font-semibold text-primary underline-offset-4 hover:underline focus-visible:underline"
            >
              {fill(section.viewLabel, "category", category.label)}
              <ArrowRight
                className="size-4"
                strokeWidth={1.75}
                aria-hidden="true"
              />
            </a>

            <span
              class="absolute -bottom-px left-0 h-0.5 w-16 bg-category"
              aria-hidden="true"
            ></span>
          </div>

          <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6 lg:grid-cols-4 lg:gap-8">
            {items.map(({ data }) => (
              <li>
                <ProductCard
                  product={data}
                  sizes={imageSizes}
                  headingLevel={4}
                />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import "../../../scripts/reveal";
  import "../../../scripts/tabs";
</script>
