---
import { Building2 } from "lucide-react";

import { partnerInfo as section } from "../../../data/contact";
import { confirmed, site } from "../../../data/site";
import PendingContent from "../../ui/PendingContent.astro";

/**
 * Contact Us "Partner Company Information" (SITE_STRUCTURE.md §4.7
 * section 5, COMPONENT_INVENTORY.md PartnerInfo). BLOCKED (C-04); see
 * data/contact.ts.
 *
 * Production renders the section only once `site.partner` is CONFIRMED,
 * and the paragraphs only once their wording is CONFIRMED; development
 * shows both with a pending marker. Mint alternate band after the WhatsApp
 * panel (DESIGN_SYSTEM.md §11). Heading in 5 columns from lg, beside a
 * white card in 7 that leads with the company name; stacked below lg. The
 * icon is a generic building mark, never a logo: no verified partner logo
 * exists. Content reveals once (§14).
 */

const isDev = import.meta.env.DEV;
const name = isDev ? site.partner.value : confirmed(site.partner);
const paragraphs = isDev
  ? section.paragraphs.value
  : (confirmed(section.paragraphs) ?? []);
---

{name && (
  <section aria-labelledby="partner-info-title" class="bg-bg-alt py-section">
    <div class="container-wide grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <p class="flex items-center gap-3 text-eyebrow font-semibold text-primary">
          {section.eyebrow}
        </p>

        <h2
          id="partner-info-title"
          class="mt-5 font-display text-h2 text-balance text-heading"
        >
          {section.title}
        </h2>

        <PendingContent
          item="C-04"
          note={section.pendingNote}
          class="mt-8 text-text-muted"
        />
      </div>

      <div
        class="rounded-lg border border-line bg-surface p-6 sm:p-8 lg:col-span-7 lg:p-10"
        data-reveal
      >
        <div class="flex items-center gap-5">
          <span
            class="flex size-12 shrink-0 items-center justify-center rounded-md bg-primary/10 text-primary"
            aria-hidden="true"
          >
            <Building2
              className="size-6"
              strokeWidth={1.75}
              aria-hidden="true"
            />
          </span>
          <h3 class="text-h3 font-semibold text-ink">{name}</h3>
        </div>

        {paragraphs.length > 0 && (
          <div class="mt-6 border-t border-line pt-6">
            {paragraphs.map((paragraph, index) => (
              <p
                class:list={[
                  "max-w-[68ch] text-text-muted",
                  index > 0 && "mt-4",
                ]}
              >
                {paragraph}
              </p>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
)}
