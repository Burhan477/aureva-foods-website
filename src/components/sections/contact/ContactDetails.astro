---
import { Clock, Mail, Phone } from "lucide-react";

import {
  type ContactCardCopy,
  contactInfo as section,
} from "../../../data/contact";
import { confirmed, site } from "../../../data/site";
import { getWhatsAppHref } from "../../../lib/whatsapp";
import PendingContent from "../../ui/PendingContent.astro";
import WhatsAppIcon from "../../ui/WhatsAppIcon.astro";

/**
 * Contact Us "Contact Information" (SITE_STRUCTURE.md §4.7 section 2,
 * COMPONENT_INVENTORY.md ContactDetails). BLOCKED (C-01, C-02, C-03,
 * hours); see data/contact.ts.
 *
 * Alternate Ivory band after the Ivory introduction (DESIGN_SYSTEM.md
 * §11). Heading block with the introduction beside it from lg, as on the
 * Products Overview; then three white cards, stacked below lg and in a
 * row from lg. Icon chips are Saffron on Olive (BRAND_GUIDELINES.md §3.3).
 *
 * Details render only when CONFIRMED in site.ts, as in the Footer: email
 * as `mailto:`, phone as `tel:`, WhatsApp through the shared link builder
 * (AD-11). Production leaves out cards without a confirmed detail, and the
 * section while none has one; development shows every card with a
 * PendingContent marker. Cards reveal once (§14) and stay visible without
 * JavaScript and under reduced motion.
 */

const email = confirmed(site.email);
const phone = confirmed(site.phone);
const hours = confirmed(site.hours);
const whatsAppHref = getWhatsAppHref();

interface Detail {
  label: string;
  value: string;
  href?: string;
  external?: boolean;
}

const details: Record<ContactCardCopy["id"], Detail[]> = {
  email: email
    ? [{ label: "Email", value: email, href: `mailto:${email}` }]
    : [],
  phone: [
    ...(phone
      ? [
          {
            label: "Phone",
            value: phone,
            href: `tel:${phone.replace(/[^\d+]/g, "")}`,
          },
        ]
      : []),
    ...(whatsAppHref
      ? [
          {
            label: "WhatsApp",
            value: "Chat on WhatsApp",
            href: whatsAppHref,
            external: true,
          },
        ]
      : []),
  ],
  hours: hours
    ? [
        { label: "Days", value: hours.days },
        { label: "Hours", value: hours.time },
        { label: "Time zone", value: hours.timeZone },
      ]
    : [],
};

const icons: Record<ContactCardCopy["id"], typeof Mail> = {
  email: Mail,
  phone: Phone,
  hours: Clock,
};

const cards = section.cards.filter(
  (card) => import.meta.env.DEV || details[card.id].length > 0,
);
---

{cards.length > 0 && (
  <section aria-labelledby="contact-info-title" class="bg-bg-alt py-section">
    <div class="container-wide">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-16">
        <div class="lg:col-span-6">
          <p class="flex items-center gap-3 text-eyebrow font-semibold text-primary">
            {section.eyebrow}
          </p>

          <h2
            id="contact-info-title"
            class="mt-5 font-display text-h2 text-balance text-heading"
          >
            {section.title}
          </h2>
        </div>

        <p class="max-w-[60ch] text-lead text-text lg:col-span-6">
          {section.intro}
        </p>
      </div>

      <ul class="mt-12 grid gap-6 lg:mt-16 lg:grid-cols-3 lg:gap-8">
        {cards.map((card) => {
          const Icon = icons[card.id];
          const cardDetails = details[card.id];
          return (
            <li
              class="flex flex-col rounded-lg border border-line bg-surface p-6 lg:p-8"
              data-reveal
            >
              <span
                class="flex size-12 items-center justify-center rounded-md bg-primary/10 text-primary"
                aria-hidden="true"
              >
                <Icon
                  className="size-6"
                  strokeWidth={1.75}
                  aria-hidden="true"
                />
              </span>

              <h3 class="mt-6 text-h3 font-semibold text-ink">{card.title}</h3>

              <p class="mt-3 mb-6 text-text-muted">{card.text}</p>

              {cardDetails.length > 0 && (
                <dl class="mt-auto grid gap-4 border-t border-line pt-6">
                  {cardDetails.map((detail) => (
                    <div>
                      <dt class="text-small font-medium text-text-muted">
                        {detail.label}
                      </dt>
                      <dd class="text-body font-semibold text-primary wrap-anywhere">
                        {detail.href ? (
                          <a
                            href={detail.href}
                            class="inline-flex min-h-11 items-center gap-2 underline decoration-primary/40 underline-offset-4 hover:decoration-primary"
                            {...(detail.external && {
                              target: "_blank",
                              rel: "noopener noreferrer",
                            })}
                          >
                            {detail.external && <WhatsAppIcon class="size-5" />}
                            {detail.value}
                            {detail.external && (
                              <span class="sr-only">(opens in a new tab)</span>
                            )}
                          </a>
                        ) : (
                          detail.value
                        )}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}

              {cardDetails.length === 0 && (
                <PendingContent
                  item={card.pendingItem}
                  note={card.pendingNote}
                  class="mt-auto text-text-muted"
                />
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}
