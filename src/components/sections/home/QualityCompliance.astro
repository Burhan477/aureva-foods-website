---
import { Files, MessageCircleQuestionMark, PackageSearch } from "lucide-react";

import {
  type QualityPoint,
  qualityCompliance as section,
} from "../../../data/home";
import Button from "../../ui/Button.astro";
import PendingContent from "../../ui/PendingContent.astro";
import SectionHeader from "../../ui/SectionHeader.astro";
import ComplianceList from "../ComplianceList.astro";

/**
 * Home "Quality & Certifications", shown as "Quality & Compliance"
 * (SITE_STRUCTURE.md §4.1 section 8, M3.8, C-05).
 *
 * Centred SectionHeader (DESIGN_SYSTEM.md §6.2), then the three blocks in
 * one white panel: stacked below lg, a row of three from lg. The CTA sits
 * centred below. Icons are neutral document and enquiry marks, never ticks,
 * shields or badges that could read as a certification (BRAND_GUIDELINES.md
 * §8). The blocks are not interactive, so they have no hover state.
 * Everything reveals once (§14) and stays visible without JavaScript and
 * under reduced motion.
 */

const icons: Record<QualityPoint["id"], typeof Files> = {
  "product-information": PackageSearch,
  documentation: Files,
  enquiries: MessageCircleQuestionMark,
};

const ctaClasses = "w-full text-center whitespace-normal! sm:w-auto";
---

<section aria-labelledby="quality-title" class="bg-bg py-section">
  <div class="container-wide">
    <SectionHeader
      id="quality-title"
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <ul class="mt-10 grid divide-y divide-line rounded-lg border border-line bg-surface lg:mt-12 lg:grid-cols-3 lg:divide-x lg:divide-y-0">
      {section.points.map((point) => {
        const Icon = icons[point.id];
        return (
          <li
            class="flex gap-5 p-6 sm:gap-6 sm:p-8 lg:flex-col lg:gap-5"
            data-reveal
          >
            <span
              class="flex size-12 shrink-0 items-center justify-center rounded-md bg-bg-alt text-primary"
              aria-hidden="true"
            >
              <Icon className="size-6" strokeWidth={1.75} aria-hidden="true" />
            </span>

            <div>
              <h3 class="text-h3 font-semibold text-ink">{point.title}</h3>
              <p class="mt-2 max-w-[60ch] text-text">{point.text}</p>
            </div>
          </li>
        );
      })}
    </ul>

    <ComplianceList class="mt-10" />

    <div class="mt-10 flex flex-col items-center lg:mt-12" data-reveal>
      {section.cta.href ? (
        <Button href={section.cta.href} size="lg" class={ctaClasses}>
          {section.cta.label}
        </Button>
      ) : (
        <button
          type="button"
          aria-disabled="true"
          class:list={[
            "inline-flex min-h-13 cursor-not-allowed items-center justify-center rounded-md bg-primary px-7 py-3 text-body font-semibold text-white opacity-60",
            ctaClasses,
          ]}
        >
          {section.cta.label}
          <span class="sr-only">(not available yet)</span>
        </button>
      )}

      {!section.cta.href && (
        <PendingContent
          item="M5.3"
          note={section.cta.pendingNote}
          class="mt-4"
        />
      )}
    </div>
  </div>
</section>
