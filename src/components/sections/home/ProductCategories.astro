---
import { productCategoriesSection as section } from "../../../data/home";
import { productCategories } from "../../../data/navigation";
import CategoryCard from "../../product/CategoryCard.astro";

/**
 * Home "Our Product Categories" (SITE_STRUCTURE.md §4.1 section 3, M3.3).
 *
 * Default Ivory background between the alternate About section and the
 * next one (DESIGN_SYSTEM.md §11); white cards carry the contrast. Heading
 * block left-aligned, with the intro beside it from lg. Cards: 1 column,
 * 3 from md (§6.2). Cards reveal once with an 80 ms stagger (§14) and stay
 * visible without JavaScript and under reduced motion.
 */

/** Crop focus per image: the fresh produce photo leans left, away from the off-catalogue tomatoes */
const imagePositions: Partial<Record<string, string>> = {
  "fresh-fruits-vegetables": "35% 50%",
};
---

<section aria-labelledby="categories-title" class="bg-bg py-section">
  <div class="container-wide">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-16" data-reveal>
      <div class="lg:col-span-7">
        <p class="flex items-center gap-3 text-eyebrow font-semibold text-olive uppercase">
          <span class="h-px w-8 bg-olive" aria-hidden="true"></span>
          {section.eyebrow}
        </p>

        <h2
          id="categories-title"
          class="mt-5 font-display text-h2 text-heading"
        >
          {section.title}
        </h2>
      </div>

      <p class="max-w-[68ch] text-lead text-text lg:col-span-5">
        {section.intro}
      </p>
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-3 lg:mt-16 lg:gap-8">
      {productCategories.map((category, index) => {
        const copy = section.cards[category.id];
        return (
          <li
            data-reveal
            style={`transition-delay: calc(var(--reveal-stagger) * ${index})`}
          >
            <CategoryCard
              category={category}
              description={copy.description}
              examples={copy.examples}
              examplesLabel={section.examplesLabel}
              ctaLabel={copy.ctaLabel}
              imagePosition={imagePositions[category.id]}
            />
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script>
  import "../../../scripts/reveal";
</script>
