---
import { Picture } from "astro:assets";

import aboutImage from "../../../assets/images/sections/home-about.jpg";
import { about } from "../../../data/home";
import Button from "../../ui/Button.astro";

/**
 * Home "About Aureva Foods" (SITE_STRUCTURE.md §4.1 section 2, M3.2).
 *
 * Text + image split (DESIGN_SYSTEM.md §6.2): stacked with the image first
 * below lg, 5 / 7 columns from lg. Alternate background so it separates
 * from the Ivory hero (§11). The copy and image reveal once (AD-05); both
 * stay visible without JavaScript and under reduced motion.
 */
---

<section aria-labelledby="about-title" class="bg-bg-alt py-section">
  <div class="container-wide grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:order-last lg:col-span-7" data-reveal>
      <!-- Offset outline frame: decorative, from lg only -->
      <div class="relative lg:mr-4 lg:mb-4">
        <div
          class="absolute inset-0 hidden translate-x-4 translate-y-4 rounded-lg border border-olive/25 lg:block"
          aria-hidden="true"
        ></div>
        <div class="relative aspect-4/3 overflow-hidden rounded-lg bg-ivory lg:aspect-5/4">
          <Picture
            src={aboutImage}
            alt={about.imageAlt}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            widths={[480, 800, 1200, aboutImage.width]}
            sizes="(min-width: 1344px) 724px, (min-width: 1024px) 54vw, 100vw"
            class="absolute inset-0 size-full object-cover"
          />
        </div>
      </div>
    </div>

    <div class="lg:col-span-5" data-reveal>
      <p class="flex items-center gap-3 text-eyebrow font-semibold text-olive uppercase">
        <span class="h-px w-8 bg-olive" aria-hidden="true"></span>
        {about.eyebrow}
      </p>

      <h2 id="about-title" class="mt-5 font-display text-h2 text-heading">
        {about.title}
      </h2>

      <p class="mt-6 max-w-[68ch] text-lead text-text">{about.intro}</p>

      <p class="mt-5 max-w-[68ch] border-l-2 border-saffron pl-5 text-text-muted">
        {about.closing}
      </p>

      <div class="mt-8">
        <Button href={about.cta.href} size="lg" class="w-full sm:w-auto">
          {about.cta.label}
        </Button>
      </div>
    </div>
  </div>
</section>

<script>
  import "../../../scripts/reveal";
</script>
