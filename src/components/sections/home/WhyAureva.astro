---
import { Building2, Layers, ListChecks, MessagesSquare } from "lucide-react";

import { type WhyAurevaPoint, whyAureva as section } from "../../../data/home";
import Button from "../../ui/Button.astro";

/**
 * Home "Why Aureva Foods" (SITE_STRUCTURE.md §4.1 section 7, M3.7).
 *
 * Default Ivory background after the alternate Fresh showcase
 * (DESIGN_SYSTEM.md §11). Typography and icons only, no photography and no
 * cards, so it reads differently from the product carousels above it. The
 * feature list is 1 column, 2 from sm, 4 from lg (§6.2); each point has a
 * 24 px icon (§13) on an Olive tile, with Saffron used as a mark on Olive
 * and on the short rule above each point (BRAND_GUIDELINES.md §3.3). The
 * points are not interactive, so they have no hover state. Everything
 * reveals once (§14) and stays visible without JavaScript and under
 * reduced motion.
 */

const icons: Record<WhyAurevaPoint["id"], typeof Layers> = {
  portfolio: Layers,
  discovery: ListChecks,
  b2b: Building2,
  enquiries: MessagesSquare,
};
---

<section aria-labelledby="why-title" class="bg-bg py-section">
  <div class="container-wide">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-16" data-reveal>
      <div class="lg:col-span-7">
        <p class="flex items-center gap-3 text-eyebrow font-semibold text-olive uppercase">
          <span class="h-px w-8 bg-olive" aria-hidden="true"></span>
          {section.eyebrow}
        </p>

        <h2
          id="why-title"
          class="mt-5 font-display text-h2 text-balance text-heading"
        >
          {section.title}
        </h2>
      </div>

      <p class="max-w-[68ch] text-lead text-text lg:col-span-5">
        {section.intro}
      </p>
    </div>

    <ul class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-x-8">
      {section.points.map((point, index) => {
        const Icon = icons[point.id];
        return (
          <li
            class="relative border-t border-line pt-8"
            data-reveal
            style={`transition-delay: calc(var(--reveal-stagger) * ${index})`}
          >
            <span
              class="absolute -top-px left-0 h-0.5 w-12 bg-saffron"
              aria-hidden="true"
            />

            <span
              class="flex size-12 items-center justify-center rounded-md bg-olive text-saffron"
              aria-hidden="true"
            >
              <Icon className="size-6" strokeWidth={1.75} aria-hidden="true" />
            </span>

            <h3 class="mt-6 text-h3 font-semibold text-charcoal">
              {point.title}
            </h3>

            <p class="mt-3 max-w-[68ch] text-text">{point.text}</p>
          </li>
        );
      })}
    </ul>

    <div class="mt-12 lg:mt-16" data-reveal>
      <Button href={section.cta.href} size="lg" class="w-full sm:w-auto">
        {section.cta.label}
      </Button>
    </div>
  </div>
</section>

<script>
  import "../../../scripts/reveal";
</script>
