---
import { getCollection } from "astro:content";
import { ArrowLeft, ArrowRight } from "lucide-react";

import { featuredSpices as section } from "../../../data/home";
import ProductCard from "../../product/ProductCard.astro";
import Button from "../../ui/Button.astro";
import SectionHeader from "../../ui/SectionHeader.astro";

/**
 * Home "Featured Spices" (SITE_STRUCTURE.md §4.1 section 4, M3.4).
 *
 * Alternate background after the Ivory categories section (DESIGN_SYSTEM.md
 * §11), with the Spices accent, Terracotta, as marks only (§3.4). Same
 * carousel as the Dehydrated Products Showcase (COMPONENT_INVENTORY.md §5):
 * the ten spices sit in a horizontal scroll-snap track, about 1.2 cards on
 * phones, 2 from sm, 3 from lg, 4 from xl. Previous/next buttons, the
 * position label and the progress rail come from src/scripts/carousel.ts;
 * without JavaScript the track still scrolls and keeps its scrollbar. No
 * autoplay. Cards are not links (no product pages); the CTA goes to the
 * Spices page route (D-10), built in M4.2.
 */

const products = (
  await getCollection("products", ({ data }) => data.category === "spices")
).sort((a, b) => a.data.order - b.data.order);

const trackId = "spices-carousel";

/** Card widths per breakpoint, matching the track classes below */
const imageSizes =
  "(min-width: 1344px) 296px, (min-width: 1280px) 22vw, (min-width: 1024px) 29vw, (min-width: 640px) 45vw, 75vw";

const controlClasses =
  "inline-flex size-11 items-center justify-center rounded-md border border-ink/15 bg-surface text-ink transition-colors duration-(--duration-fast) ease-out hover:not-aria-disabled:border-ink/40 aria-disabled:cursor-default aria-disabled:border-line aria-disabled:text-text-muted";
---

<section
  aria-labelledby="featured-spices-title"
  class="bg-bg py-section"
  style="--color-category: var(--color-orange)"
>
  <div class="container-wide">
    <SectionHeader
      id="featured-spices-title"
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <div class="group/carousel mt-8 lg:mt-12" data-carousel data-reveal>
      <!-- Focusable so keyboard users can scroll it with the arrow keys
           (WCAG 2.1.1: a scrollable region with no focusable content) -->
      {/* eslint-disable astro/jsx-a11y/no-noninteractive-tabindex */}
      <div
        id={trackId}
        role="region"
        aria-label={section.carouselLabel}
        tabindex="0"
        class="-mx-(--space-gutter) snap-x snap-mandatory overflow-x-auto overscroll-x-contain scroll-px-(--space-gutter) px-(--space-gutter) py-4 focus-visible:-outline-offset-2 group-data-ready/carousel:[scrollbar-width:none]"
        data-carousel-track
      >
        <!-- Gap equals the gutter, so at rest the next card starts exactly
             at the track edge instead of showing as a sliver -->
        <ul class="flex gap-(--space-gutter)">
          {products.map(({ data }) => (
            <li class="w-[78%] shrink-0 snap-start sm:w-[calc((100%-var(--space-gutter))/2)] lg:w-[calc((100%-2*var(--space-gutter))/3)] xl:w-[calc((100%-3*var(--space-gutter))/4)]">
              <ProductCard product={data} sizes={imageSizes} />
            </li>
          ))}
        </ul>
      </div>
      {/* eslint-enable astro/jsx-a11y/no-noninteractive-tabindex */}

      <!-- Progress rail: decorative; the position is also given as text -->
      <div
        class="mt-4 h-0.5 overflow-hidden bg-line"
        aria-hidden="true"
        data-carousel-js
        hidden
      >
        <span
          class="block h-full w-full bg-category"
          data-carousel-thumb
        ></span>
      </div>

      <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <!-- Arrows come before the CTA in both DOM and visual order; the
             status text is not focusable, so it may sit either side -->
        <div
          class="flex items-center justify-between gap-4 sm:flex-row-reverse sm:justify-end"
          data-carousel-js
          hidden
        >
          <p
            class="text-small text-text-muted tabular-nums"
            aria-live="polite"
            data-carousel-status
          ></p>

          <div class="flex gap-2">
            <button
              type="button"
              class={controlClasses}
              aria-label="Previous spices"
              aria-controls={trackId}
              data-carousel-prev
            >
              <ArrowLeft
                className="size-5"
                strokeWidth={1.75}
                aria-hidden="true"
              />
            </button>
            <button
              type="button"
              class={controlClasses}
              aria-label="Next spices"
              aria-controls={trackId}
              data-carousel-next
            >
              <ArrowRight
                className="size-5"
                strokeWidth={1.75}
                aria-hidden="true"
              />
            </button>
          </div>
        </div>

        <Button href={section.cta.href} size="lg" class="w-full sm:w-auto">
          {section.cta.label}
        </Button>
      </div>
    </div>
  </div>
</section>

<script>
  import "../../../scripts/reveal";
  import "../../../scripts/carousel";
</script>
