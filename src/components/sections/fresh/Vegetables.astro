---
import { getCollection } from "astro:content";

import { vegetables as section } from "../../../data/fresh-fruits-vegetables";
import ProductCard from "../../product/ProductCard.astro";
import Button from "../../ui/Button.astro";
import SectionHeader from "../../ui/SectionHeader.astro";

/**
 * Fresh Fruits & Vegetables "Fresh Vegetables" (SITE_STRUCTURE.md §4.6
 * section 2). DRAFT-TEMP; see data/fresh-fruits-vegetables.ts.
 *
 * The products in the "Fresh Vegetables" group of products.json (§5.3),
 * in catalogue order, as shared ProductCards. Alternate Ivory band after
 * the Ivory introduction (DESIGN_SYSTEM.md §11), with Leaf Green, the
 * Fresh accent, on the eyebrow rule and card marks (§3.4).
 *
 * A centred SectionHeader (DESIGN_SYSTEM.md §6.2), then the two cards
 * (2 columns from sm, held to 4xl so they keep the Fruits card size) and
 * the button, centred below.
 *
 * Buttons are the standard Primary and Secondary (§9.1). Card images are
 * lazy. Content reveals once (§14) and stays visible without JavaScript
 * and under reduced motion.
 *
 * The section `id` is the target of the Page Introduction's "Explore Our
 * Products" link.
 */

const products = (await getCollection("products"))
  .filter(({ data }) => data.group === "Fresh Vegetables")
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data }) => data);

/** Card widths per breakpoint, matching the grid classes below */
const imageSizes = "(min-width: 1024px) 432px, (min-width: 640px) 46vw, 100vw";
---

<section
  id={section.id}
  aria-labelledby="fresh-vegetables-title"
  class="bg-bg-alt py-section"
  style="--color-category: var(--color-teal)"
>
  <div class="container-wide">
    <SectionHeader
      id="fresh-vegetables-title"
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <ul class="mx-auto mt-10 grid max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-12 lg:gap-8">
      {products.map((product) => (
        <li data-reveal>
          <ProductCard
            product={product}
            sizes={imageSizes}
            label={section.cardLabel}
          />
        </li>
      ))}
    </ul>

    <div
      class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:justify-center lg:mt-12"
      data-reveal
    >
      <Button href={section.primaryCta.href} size="lg" class="w-full sm:w-auto">
        {section.primaryCta.label}
      </Button>
    </div>
  </div>
</section>
