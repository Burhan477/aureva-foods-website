---
import { Font, getImage } from "astro:assets";

import logo from "../assets/images/brand/aureva-foods-logo.webp";
import FloatingWhatsApp from "../components/layout/FloatingWhatsApp.astro";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import ScrollTopButton from "../components/layout/ScrollTopButton.astro";
import SkipLink from "../components/layout/SkipLink.astro";
import type { NavLink } from "../data/navigation";
import { site } from "../data/site";
import {
  type JsonLd,
  breadcrumbList,
  collectionPage,
  organizationGraph,
  toJsonLd,
} from "../lib/structuredData";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Keeps the page out of search results, and leaves out its canonical URL (404) */
  noindex?: boolean;
  /** Adds Organization and WebSite structured data (Home) */
  organization?: boolean;
  /** Adds BreadcrumbList structured data matching the visible trail (category pages) */
  breadcrumbs?: NavLink[];
  /** Adds CollectionPage structured data listing these items (Products and category pages) */
  collection?: { name: string; url?: string }[];
  /** Share image, a 1200 x 630 JPEG in public/og (SEO_AND_PERFORMANCE.md §6); the logo card when left out */
  ogImage?: { path: string; alt: string };
}

const {
  title,
  description,
  noindex = false,
  organization = false,
  breadcrumbs,
  collection,
  ogImage = { path: "/og/default.jpg", alt: "Aureva Foods logo" },
} = Astro.props;

// Canonical and share URLs (SEO_AND_PERFORMANCE.md §4, §6) are absolute,
// built from the production `site` URL (C-18) plus the page path. A
// noindex page has neither.
const pageUrl =
  Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImageUrl = Astro.site ? new URL(ogImage.path, Astro.site).href : null;

// Structured data (§7)
const graph: JsonLd[] = [];
if (Astro.site && organization) {
  const logoImage = await getImage({ src: logo, width: 600, format: "png" });
  graph.push(
    ...organizationGraph(Astro.site, new URL(logoImage.src, Astro.site).href),
  );
}
if (Astro.site && breadcrumbs) {
  graph.push(breadcrumbList(Astro.site, breadcrumbs));
}
if (Astro.site && pageUrl && collection) {
  graph.push(
    collectionPage(
      Astro.site,
      { url: pageUrl, title, description },
      collection,
    ),
  );
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name.value} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {ogImageUrl && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImage.alt} />
        <meta name="twitter:image:alt" content={ogImage.alt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-inter" preload />
    <!-- Page crossfade opt-in (§14). Inline: from the external stylesheet
         Chrome often skipped the transition. Timing is in global.css. -->
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }
    </style>
    {graph.length > 0 && (
      <script is:inline type="application/ld+json" set:html={toJsonLd(graph)} />
    )}
  </head>
  <body>
    <SkipLink />
    <Header />
    <slot />
    <Footer />
    <FloatingWhatsApp />
    <ScrollTopButton />
  </body>
</html>

<script>
  import "../scripts/reveal";
</script>
